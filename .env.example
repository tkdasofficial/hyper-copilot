# Lovable AI Gateway API key (for Gemini image models, Gemini TTS speech, and title generation)
LOVABLE_API_KEY=

# Supabase backend service role key (for administrative operations bypassing RLS)
SUPABASE_SERVICE_ROLE_KEY=

# Pixazo API key for image and video models (can also be configured via Supabase vault)
PIXAZO_API_KEY=

# Nvidia API key for Nemotron text model (can also be configured via Supabase vault)
NVIDIA_API_KEY=

# Secret token for authenticating scheduled background cron jobs
LOVABLE_CRON_SECRET=

# Previous cron secret used during secret rotation (optional)
LOVABLE_CRON_SECRET_PREVIOUS=
